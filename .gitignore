# macOS
.DS_Store
Thumbs.db

# Python / uv
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Secrets and editor settings
.env
.vscode/
.idea/

# Office lock files (created while a file is open in Excel/PowerPoint/Word)
~$*
.~lock.*

# File-system leftovers
.fuse_hidden*

# Claude Code: only personal settings stay local
.claude/settings.local.json
# Claude Code plan/progress workspaces
.superpowers/

# Node packages and caches (the dashboard keeps its own in dashboard/)
node_modules/

# Generated results, rebuildable from data/ + code
outputs/*
!outputs/.gitkeep
tests/runs/
*.duckdb
*.parquet
*.log
*.tmp

# Competition originals (PDF/Word). We commit the Markdown copies in reference/ instead.
reference/official/

# chat logs
AI_Logs
